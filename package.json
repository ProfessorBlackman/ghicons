{
  "name": "ghicons-workspace",
  "private": true,
  "type": "module",
  "description": "Monorepo for GHIcons \u2014 Ghanaian symbols, gathered and standardised for developers.",
  "license": "MIT",
  "author": "Methuselah Nwodobeh",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProfessorBlackman/ghicons"
  },
  "bugs": {
    "url": "https://github.com/ProfessorBlackman/ghicons/issues"
  },
  "homepage": "https://ghicons.methuselah.site",
  "scripts": {
    "validate": "node tools/validate.mjs",
    "generate": "pnpm run generate:core && pnpm run generate:react && pnpm run generate:stories",
    "generate:core": "node tools/build-core.mjs",
    "generate:react": "node tools/generators/react.mjs",
    "generate:stories": "node tools/generators/stories.mjs",
    "build": "pnpm run validate && pnpm run generate && pnpm run build:react",
    "build:react": "tsc -p packages/react/tsconfig.build.json && vite build -c packages/react/vite.config.ts",
    "clean": "node tools/clean.mjs",
    "dev": "vite -c playground/vite.config.ts",
    "preview": "vite preview -c playground/vite.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "dir:rename": "node tools/clean-filenames.mjs"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.7",
    "@eslint/js": "^9.39.3",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-onboarding": "^8.6.17",
    "@storybook/blocks": "^8.6.14",
    "@storybook/experimental-addon-test": "^8.6.14",
    "@storybook/react": "^8.6.17",
    "@storybook/react-vite": "^8.6.17",
    "@storybook/test": "^8.6.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^16.5.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^8.6.17",
    "svgo": "4.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.6.3+sha1.43e3aa4a371d889dfb0ffe7a9b5d4ca0668ccaa9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
